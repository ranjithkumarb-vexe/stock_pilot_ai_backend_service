# StockPilot AI backend - copy to .env (git-ignored). Never commit real secrets.
# Local Postgres on a unix socket? use e.g.
#   DATABASE_URL=postgresql://stockpilot_app:stockpilot_dev_pw@/stockpilot_dev?host=/tmp
#   DATABASE_ADMIN_URL=postgresql://<your-os-user>@/stockpilot_dev?host=/tmp

# --- runtime ---------------------------------------------------------------
APP_ENV=dev                      # dev | test | prod  (prod forbids AUTH_MODE=dev and CORS '*', hides /docs)
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173   # comma-separated allowed browser origins; empty = CORS disabled
TRUST_PROXY=false                # true only behind a proxy that sets X-Forwarded-For (rate limiting by client IP)
MAX_BODY_BYTES=1048576           # request body cap
REQUEST_TIMEOUT_S=30

# --- database (Postgres 15+ with pgvector; Supabase-compatible, ADR-002) ------
# API pool: non-superuser role stockpilot_app (NOBYPASSRLS) so Row-Level Security is enforced.
DATABASE_URL=postgresql://stockpilot_app:stockpilot_dev_pw@localhost:5432/stockpilot_dev
# Owner/admin (BYPASSRLS): migrations, seed, background jobs ONLY. Optional at API runtime.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/stockpilot_dev
# Password applied to role stockpilot_app by `python -m app.core.migrate`. CHANGE IN EVERY DEPLOYMENT
# and keep it identical to the password inside DATABASE_URL.
APP_DB_PASSWORD=stockpilot_dev_pw
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_ADMIN_POOL_MAX=4
DB_STATEMENT_TIMEOUT_MS=15000
SP_TEST_DB=stockpilot_test       # test database name (agents use stockpilot_test_a / _b / _c)

# --- auth (ADR-003) --------------------------------------------------------
AUTH_MODE=dev                    # dev | supabase
DEV_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef   # >=32 bytes; dev mode only
DEV_TOKEN_TTL_S=28800
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server-side only; never sent to the browser
SUPABASE_JWT_SECRET=             # HS256 projects
SUPABASE_JWKS_URL=               # RS256/ES256 projects, e.g. https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
JWT_AUDIENCE=authenticated
JWT_ISSUER=                      # optional strict issuer check, e.g. https://<ref>.supabase.co/auth/v1
STREAM_TOKEN_TTL_S=60

# --- rate limiting (in-memory token buckets; per IP and per authenticated user) -----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_BURST=200
RATE_LIMIT_IP_PER_S=20
RATE_LIMIT_USER_BURST=120
RATE_LIMIT_USER_PER_S=10

# --- cache / queue (optional, ADR-004: in-process by default) ----------------
REDIS_URL=

# --- market data (SPEC 6) ---------------------------------------------------
MARKET_DATA_SOURCE=simulated     # simulated | alpaca | finnhub
ALPACA_KEY_ID=                   # market data only
ALPACA_SECRET=
FINNHUB_KEY=
FRED_API_KEY=
SEC_USER_AGENT="StockPilot <your-email>"   # SEC EDGAR requires a declared contact

# --- LLM (ADR-005) -----------------------------------------------------------
LLM_PROVIDER=mock                # mock | meta  (mock needs no key; degraded/template mode)
META_MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MODEL_STANDARD=muse-spark-1.3
MODEL_CONTRIBUTOR=muse-spark-1.3-contributor
MODEL_DEEP=muse-wonder-1.0
LLM_BUDGET_ALERT_USD=100
LLM_BUDGET_HARD_STOP_USD=140

# --- observability -----------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- paper trading -----------------------------------------------------------
PAPER_SLIPPAGE_BPS=5

# --- knobs read straight from the environment (not in app.core.config) --------------------------------------------
# (integration pass 1: CR-6 / CR-10 / D / E; every value shown is the code default)
EDGAR_CACHE_DIR=                  # default ~/.cache/stockpilot/edgar (SEC responses cached on disk)
LLM_USER_DAILY_BUDGET_USD=1.00    # per-user daily LLM spend cap (degrades to templates beyond it)
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_S=0.5
LLM_BACKOFF_CAP_S=20
LLM_REASONING_EFFORT=low
LLM_PRICE_IN_PER_MTOK=1.00        # placeholders until the provider price list is verified (docs/VERIFIED.md)
LLM_PRICE_OUT_PER_MTOK=4.00
MARKETDATA_AUTOSTART=1            # 0 = no market-data background tasks (tests)
MARKETDATA_SIM_SEED=42            # simulated feed: seed, tick seconds, volatility per tick
MARKETDATA_SIM_TICK_S=1.0
MARKETDATA_SIM_SIGMA=0.0004
MARKETDATA_POLL_INTERVAL_S=30     # REST polling fallback
MARKETDATA_FINNHUB_INTERVAL_S=5
MARKETDATA_HEARTBEAT_S=15         # SSE heartbeat
PERSONALIZATION_AUTOSTART=1       # 0 = no feature-recompute scheduler
PAPER_SWEEP_INTERVAL_S=5          # queued/working order sweeper (0 = off)
ALERTS_AUTOSTART=1                # 0 = no alert monitor
ALERTS_POLL_INTERVAL_S=           # alert monitor interval (code default)
ALERTS_EDGAR_LIVE=1               # default 1: poll SEC for 8-K filings (needs a real SEC_USER_AGENT); 0 = offline
AUDIT_BACKFILL=1                  # backfill audit trace rows from existing briefs on start
EVALS_RESULTS_PATH=               # default evals/results/latest.json
# E2E (frontend repo scripts/e2e.sh) overrides these for its throw-away run: RATE_LIMIT_USER_BURST=300 RATE_LIMIT_USER_PER_S=30
