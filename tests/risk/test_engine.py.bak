"""BE-06: risk engine unit + property tests (T-RISK-01, T-RISK-03, T-RISK-04)."""

from __future__ import annotations

import math
import os
from decimal import Decimal

import pytest
from hypothesis import HealthCheck, given, settings
from hypothesis import strategies as st

from app.modules.risk import (
    Portfolio,
    Position,
    Rules,
    TradeProposal,
    compute_metrics,
    current_violations,
    curve_summary,
    default_rules_for_tier,
    rule_statuses,
    suggest_reduction,
    validate,
)

D = Decimal
EXAMPLES = int(os.environ.get("HYPOTHESIS_EXAMPLES", "2500"))
PROP = settings(max_examples=EXAMPLES, deadline=None, suppress_health_check=[HealthCheck.too_slow])


def pos(sym: str, qty: str, px: str, sector: str | None = "Tech", prev: str | None = None) -> Position:
    return Position(sym, sector, D(qty), D(px), D(prev) if prev else None)


# ---------------------------------------------------------------------------------------- defaults


@pytest.mark.parametrize(
    ("tier", "expected"),
    [
        (1, (10, 25, 10, 3, 10)),
        (2, (10, 25, 10, 3, 10)),
        (3, (15, 35, 15, 5, 5)),
        (4, (25, 50, 25, 10, 0)),
        (5, (25, 50, 25, 10, 0)),
    ],
)
def test_default_rules_by_tier_match_spec_table(tier: int, expected: tuple[int, ...]) -> None:
    r = default_rules_for_tier(tier)
    assert (r.pos, r.sec, r.dd, r.trades, r.cash) == tuple(
        D(x) if i != 3 else x for i, x in enumerate(expected)
    )
    assert r.to_dict() == {
        "pos": expected[0],
        "sec": expected[1],
        "dd": expected[2],
        "trades": expected[3],
        "cash": expected[4],
    }


@pytest.mark.parametrize("bad", [0, 6, -1, 3.5, "3", True, None])
def test_default_rules_rejects_invalid_tier(bad: object) -> None:
    with pytest.raises(ValueError, match="tier"):
        default_rules_for_tier(bad)  # type: ignore[arg-type]


def test_rules_from_mapping_roundtrip() -> None:
    r = Rules.from_mapping({"pos": 12.5, "sec": "30", "dd": 15, "trades": 4, "cash": 2.5})
    assert r.pos == D("12.5") and r.trades == 4
    assert Rules.from_mapping(r.to_dict()) == r


# ---------------------------------------------------------------------------------------- metrics


def test_weights_sectors_hhi_for_a_known_portfolio() -> None:
    pf = Portfolio(
        D(100), (pos("A", "10", "30", "Tech"), pos("B", "10", "20", "Tech"), pos("C", "10", "40", "Health"))
    )
    m = compute_metrics(pf)
    assert m.equity == D(1000) and m.invested == D(900)
    assert m.weights == {"A": D("0.3"), "B": D("0.2"), "C": D("0.4")}
    assert m.cash_weight == D("0.1")
    assert sum(m.weights.values()) + m.cash_weight == 1
    assert m.sector_weights == {"Tech": D("0.5"), "Health": D("0.4")}
    assert m.hhi == pytest.approx((300 / 900) ** 2 + (200 / 900) ** 2 + (400 / 900) ** 2)
    assert m.effective_n == pytest.approx(1 / m.hhi)  # type: ignore[operator]
    assert m.max_position == ("C", D("0.4"))


def test_empty_portfolio_has_no_hhi_and_is_flagged() -> None:
    m = compute_metrics(Portfolio(D(0)))
    assert m.hhi is None and m.effective_n is None and m.max_position is None
    assert "empty_portfolio" in m.flags


def test_cash_only_portfolio() -> None:
    m = compute_metrics(Portfolio(D(1000)))
    assert m.cash_weight == 1 and m.hhi is None and m.weights == {}


def test_day_change_uses_prev_close() -> None:
    pf = Portfolio(D(0), (pos("A", "10", "110", prev="100"), pos("B", "5", "50")))
    assert compute_metrics(pf).day_change == D(100)  # B has no prev_close -> ignored


def test_unclassified_sector_bucket() -> None:
    m = compute_metrics(Portfolio(D(0), (pos("A", "1", "10", None),)))
    assert m.sector_weights == {"Unclassified": D(1)}


@given(
    cash=st.decimals(min_value=0, max_value=10**7, places=2),
    legs=st.lists(
        st.tuples(
            st.sampled_from(["A", "B", "C", "D", "E", "F"]),
            st.sampled_from(["Tech", "Health", "Energy", None]),
            st.decimals(min_value=1, max_value=10**5, places=0),
            st.decimals(min_value="0.01", max_value=10**5, places=2),
        ),
        min_size=1,
        max_size=6,
        unique_by=lambda t: t[0],
    ),
)
@PROP
def test_t_risk_01_weights_sum_to_one_and_hhi_bounded(cash: Decimal, legs: list) -> None:  # type: ignore[type-arg]
    """T-RISK-01: sum of weights = 1 +- 1e-9 and HHI in [1/N, 1]."""
    pf = Portfolio(cash, tuple(Position(s, sec, q, p) for s, sec, q, p in legs))
    m = compute_metrics(pf)
    assert m.equity > 0
    assert abs(float(sum(m.weights.values()) + m.cash_weight) - 1.0) <= 1e-9
    assert abs(float(sum(m.invested_weights.values())) - 1.0) <= 1e-9
    assert abs(float(sum(m.sector_weights.values()) + m.cash_weight) - 1.0) <= 1e-9
    n = len(m.invested_weights)
    assert m.hhi is not None and m.effective_n is not None
    assert 1.0 / n - 1e-12 <= m.hhi <= 1.0 + 1e-12
    assert 1.0 - 1e-9 <= m.effective_n <= n + 1e-9


# ---------------------------------------------------------------------------------------- history metrics


def _walk(n: int, step: float = 0.01) -> list[float]:
    out = [100.0]
    for i in range(n):
        out.append(out[-1] * (1 + step * (1 if i % 2 == 0 else -0.6)))
    return out


def test_vol_and_beta_from_curves() -> None:
    bench = _walk(100, 0.01)
    port = [100 + (b - 100) * 1.5 for b in bench]  # exactly 1.5x leveraged moves in level terms
    m = compute_metrics(Portfolio(D(1000)), equity_curve=port, benchmark_curve=bench)
    assert m.vol_60d is not None and m.vol_60d > 0
    assert m.beta is not None and 1.0 < m.beta < 2.0
    assert m.flags == ()


def test_beta_of_the_benchmark_against_itself_is_one() -> None:
    bench = _walk(80)
    m = compute_metrics(Portfolio(D(1000)), equity_curve=bench, benchmark_curve=bench)
    assert m.beta == pytest.approx(1.0)


def test_t_risk_03_drawdown_100_to_85_hits_a_15_percent_rule() -> None:
    curve = [100.0, 105.0, 100.0, 90.0, 85.0 * 105 / 100]  # last = 89.25 -> 15% below the 105 peak
    pf = Portfolio(D(9000), (pos("A", "1", "1", None),))
    m = compute_metrics(pf, equity_curve=curve)
    assert m.drawdown_pct == pytest.approx(15.0)
    assert m.max_drawdown_pct == pytest.approx(15.0)
    rules = Rules(D(100), D(100), D(15), 99, D(0))
    dd = next(v for v in current_violations(m, rules) if v.rule == "dd")
    assert dd.value is not None and dd.value >= D(15)
    status = next(s for s in rule_statuses(m, rules) if s.key == "dd")
    assert status.status == "breach"
    # just under the threshold: no breach
    m2 = compute_metrics(pf, equity_curve=[100.0, 85.1])
    assert not any(v.rule == "dd" for v in current_violations(m2, rules))


def test_non_positive_equity_levels_are_invalid_not_infinite() -> None:
    """Regression (found by Hypothesis): [3e-307, -1.0] used to give an infinite drawdown."""
    m = compute_metrics(Portfolio(D(0)), equity_curve=[3.058014515722499e-307, -1.0])
    assert m.drawdown_pct is None and m.max_drawdown_pct is None and "invalid_equity_curve" in m.flags
    s = curve_summary([100.0, 0.0, 50.0])
    assert s.drawdown_pct is None


def test_curve_summary_matches_compute_metrics_on_clean_data() -> None:
    bench = _walk(100, 0.01)
    port = [100 + (b - 100) * 1.5 for b in bench]
    s = curve_summary(port, bench)
    m = compute_metrics(Portfolio(D(1)), equity_curve=port, benchmark_curve=bench)
    assert s.beta == pytest.approx(m.beta) and s.max_drawdown_pct == pytest.approx(m.max_drawdown_pct)  # type: ignore[arg-type]
    assert s.period_return_pct == pytest.approx((port[-1] / port[0] - 1) * 100)
    assert s.benchmark_return_pct == pytest.approx((bench[-1] / bench[0] - 1) * 100)
    assert curve_summary([100.0] * 40, bench[:40]).flags == ("zero_variance",)
    assert "insufficient_history" in curve_summary([1.0, 2.0]).flags
    assert "no_benchmark" in curve_summary(port).flags


def test_drawdown_recovers_when_curve_makes_new_high() -> None:
    m = compute_metrics(Portfolio(D(1)), equity_curve=[100, 80, 120])
    assert m.drawdown_pct == 0.0 and m.max_drawdown_pct == pytest.approx(20.0)


def test_t_risk_04_zero_variance_returns_none_and_flag() -> None:
    flat = [100.0] * 60
    m = compute_metrics(Portfolio(D(100)), equity_curve=flat, benchmark_curve=_walk(59))
    assert m.vol_60d is None and m.beta is None
    assert "zero_variance" in m.flags
    # benchmark flat
    m = compute_metrics(Portfolio(D(100)), equity_curve=_walk(59), benchmark_curve=[50.0] * 60)
    assert m.beta is None and "zero_variance" in m.flags and m.vol_60d is not None


def test_t_risk_04_new_listing_insufficient_history() -> None:
    m = compute_metrics(Portfolio(D(100)), equity_curve=[100, 101, 102], benchmark_curve=[10, 11, 12])
    assert m.vol_60d is None and m.beta is None and "insufficient_history" in m.flags
    # no curve at all
    m = compute_metrics(Portfolio(D(100)))
    assert m.vol_60d is None and m.drawdown_pct is None and "insufficient_history" in m.flags
    # single point
    m = compute_metrics(Portfolio(D(100)), equity_curve=[100.0])
    assert m.vol_60d is None and m.drawdown_pct == 0.0


def test_invalid_series_are_flagged_not_raised() -> None:
    m = compute_metrics(
        Portfolio(D(100)), equity_curve=[100.0, 0.0, 50.0, float("nan")] * 20, benchmark_curve=[1.0] * 80
    )
    assert m.vol_60d is None
    assert any(f in m.flags for f in ("invalid_equity_curve", "insufficient_history"))
    m = compute_metrics(Portfolio(D(100)), equity_curve=_walk(60), benchmark_curve=[0.0, 1.0] * 30)
    assert m.beta is None and "invalid_benchmark" in m.flags
    m = compute_metrics(Portfolio(D(100)), equity_curve=_walk(60))
    assert m.beta is None and "no_benchmark" in m.flags and m.vol_60d is not None


def test_mismatched_curve_lengths_use_most_recent_overlap() -> None:
    bench = _walk(120)
    port = bench[-70:]
    m = compute_metrics(Portfolio(D(100)), equity_curve=port, benchmark_curve=bench)
    assert m.beta == pytest.approx(1.0)


_LEVEL = st.one_of(
    st.floats(min_value=-10, max_value=1e9), st.just(float("nan")), st.just(float("inf")), st.just(0.0)
)


@given(
    curve=st.lists(_LEVEL, max_size=80),
    bench=st.one_of(st.none(), st.lists(_LEVEL, max_size=80)),
    cash=st.decimals(min_value=0, max_value=10**6, places=2),
)
@PROP
def test_compute_metrics_never_raises_on_garbage_series(
    curve: list[float], bench: list[float] | None, cash: Decimal
) -> None:
    m = compute_metrics(Portfolio(cash), equity_curve=curve, benchmark_curve=bench)
    for v in (m.vol_60d, m.beta, m.drawdown_pct, m.max_drawdown_pct):
        assert v is None or math.isfinite(v)


# ---------------------------------------------------------------------------------------- rule status


def test_rule_statuses_for_the_seeded_priya_portfolio() -> None:
    from scripts.seed_data import PRIYA, UNIVERSE_BY_SYMBOL

    positions = tuple(
        Position(s, UNIVERSE_BY_SYMBOL[s].sector, D(q), UNIVERSE_BY_SYMBOL[s].px)
        for s, q, _ in PRIYA.holdings
    )
    m = compute_metrics(Portfolio(PRIYA.cash, positions, trades_7d=1))
    rules = default_rules_for_tier(2)
    st_ = {s.key: s for s in rule_statuses(m, rules)}
    assert st_["pos"].subject == "JNJ" and st_["pos"].status == "breach"
    assert st_["sec"].subject == "Consumer Staples" and st_["sec"].status == "breach"
    assert st_["trades"].status == "ok" and st_["cash"].status == "ok"
    assert [v.rule for v in current_violations(m, rules)] == ["pos", "sec"]
    assert next(v.message for v in current_violations(m, rules)).startswith("JNJ is 10.7% of your portfolio")


def test_trades_rule_states() -> None:
    m = compute_metrics(Portfolio(D(1000), trades_7d=9))
    rules = Rules(D(100), D(100), D(100), 10, D(0))
    assert next(s for s in rule_statuses(m, rules) if s.key == "trades").status == "warn"
    m = compute_metrics(Portfolio(D(1000), trades_7d=11))
    assert next(s for s in rule_statuses(m, rules) if s.key == "trades").status == "breach"
    assert any(v.rule == "trades" for v in current_violations(m, rules))


def test_cash_buffer_breach_and_zero_buffer() -> None:
    pf = Portfolio(D(30), (pos("A", "1", "970"),))
    rules = Rules(D(100), D(100), D(100), 9, D(5))
    assert next(s for s in rule_statuses(compute_metrics(pf), rules) if s.key == "cash").status == "breach"
    assert any(v.rule == "cash" for v in current_violations(compute_metrics(pf), rules))
    rules0 = Rules(D(100), D(100), D(100), 9, D(0))
    assert next(s for s in rule_statuses(compute_metrics(pf), rules0) if s.key == "cash").status == "ok"


# ---------------------------------------------------------------------------------------- validate


@pytest.fixture
def portfolio() -> Portfolio:
    # equity = 20000 + 30000 = 50000... built to hit round numbers
    return Portfolio(
        D(20000),
        (
            Position("AAA", "Tech", D(100), D(100)),  # 10000 -> 20 %
            Position("BBB", "Tech", D(100), D(100)),  # 10000 -> 20 %  (Tech 40 %)
            Position("CCC", "Health", D(100), D(100)),  # 10000 -> 20 %
        ),
        trades_7d=1,
    )


RULES = Rules(D(25), D(50), D(15), 3, D(10))


def test_buy_inside_all_limits_is_allowed_with_passing_checks(portfolio: Portfolio) -> None:
    res = validate(TradeProposal("CCC", "buy", D(10), D(100)), portfolio, RULES)
    assert res.allowed and not res.violations
    assert [c.label for c in res.checks] == [
        "Paper cash",
        "Max position 25%",
        "Max sector 50%",
        "Min cash buffer 10%",
        "Trades per week 3",
    ]
    assert all(c.severity == "pass" for c in res.checks)
    assert res.checks[1].detail == "CCC would be 22.0%"
    assert res.checks[0].detail == "Cost $1,000 of $20,000 available"


def test_position_cap_violation_message(portfolio: Portfolio) -> None:
    res = validate(TradeProposal("AAA", "buy", D(60), D(100)), portfolio, RULES)
    assert not res.allowed
    v = next(v for v in res.violations if v.rule == "pos")
    assert v.value is not None and v.value > D(25) and not v.hard
    assert "AAA would be 32.0%" in v.message
    assert any(c.severity == "blocked" and c.key == "pos" for c in res.checks)


def test_sector_cap_violation(portfolio: Portfolio) -> None:
    # Tech is 20000 of 50000 (40 %); adding 4000 -> 48 % is still inside the 50 % cap
    assert not any(
        v.rule == "sec"
        for v in validate(
            TradeProposal("NEW", "buy", D(40), D(100), sector="Tech"), portfolio, RULES
        ).violations
    )
    res = validate(TradeProposal("NEW", "buy", D(100), D(100), sector="Tech"), portfolio, RULES)
    assert any(v.rule == "sec" and "Tech would be 60.0%" in v.message for v in res.violations)


def test_cash_buffer_and_funds(portfolio: Portfolio) -> None:
    res = validate(
        TradeProposal("CCC", "buy", D(110), D(100)), portfolio, RULES
    )  # spends 11000 -> cash 9000 = 18 %
    assert not any(v.rule == "cash" for v in res.violations)
    res = validate(
        TradeProposal("CCC", "buy", D(160), D(100)), portfolio, RULES
    )  # 16000 -> cash 4000 = 8 % < 10 %
    assert any(v.rule == "cash" for v in res.violations)
    res = validate(TradeProposal("CCC", "buy", D(250), D(100)), portfolio, RULES)  # more than the cash
    funds = next(v for v in res.violations if v.rule == "funds")
    assert funds.hard and not res.allowed and res.blocked_hard


def test_zero_cash_buffer_adds_no_cash_row() -> None:
    rules = Rules(D(100), D(100), D(100), 9, D(0))
    res = validate(TradeProposal("A", "buy", D(1), D(10)), Portfolio(D(100)), rules)
    assert all(c.key != "cash" for c in res.checks)


def test_sell_rules(portfolio: Portfolio) -> None:
    ok = validate(TradeProposal("AAA", "sell", D(40), D(100)), portfolio, RULES)
    assert ok.allowed and ok.checks[0].label == "No shorting (MVP)"
    assert ok.checks[0].detail == "Selling 40 of 100 shares held"
    bad = validate(TradeProposal("AAA", "sell", D(101), D(100)), portfolio, RULES)
    assert not bad.allowed and bad.violations[0].hard
    assert bad.violations[0].message == "You hold 100 shares and cannot sell 101"
    unknown = validate(TradeProposal("ZZZ", "sell", D(1), D(100)), portfolio, RULES)
    assert not unknown.allowed


def test_quantity_below_one_is_hard_blocked(portfolio: Portfolio) -> None:
    res = validate(TradeProposal("AAA", "buy", D("0.5"), D(100)), portfolio, RULES)
    assert (
        not res.allowed
        and res.checks[0].label == "Quantity"
        and res.checks[0].detail == "Enter at least 1 share"
    )
    assert res.violations[0].hard


def test_trades_per_week_is_a_note_for_sells_and_a_block_for_buys() -> None:
    pf = Portfolio(D(200000), (Position("AAA", "Tech", D(100), D(100)),), trades_7d=3)
    sell = validate(TradeProposal("AAA", "sell", D(1), D(100)), pf, RULES)
    assert sell.allowed and sell.warnings and sell.warnings[0].rule == "trades"
    assert [c.severity for c in sell.checks if c.key == "trades"] == ["note"]
    buy = validate(TradeProposal("AAA", "buy", D(1), D(100)), pf, RULES)
    assert not buy.allowed and buy.violations[0].rule == "trades"
    assert [c.severity for c in buy.checks if c.key == "trades"] == ["blocked"]


def test_validate_result_serialises() -> None:
    res = validate(TradeProposal("A", "buy", D(1), D(10)), Portfolio(D(100)), RULES)
    data = res.to_dict()
    assert data["allowed"] in (True, False) and isinstance(data["checks"], list)
    for c in res.checks:
        assert set(c.to_dict()) == {"key", "ok", "severity", "label", "detail"}


def test_empty_equity_buy_is_blocked() -> None:
    res = validate(TradeProposal("A", "buy", D(1), D(10)), Portfolio(D(0)), RULES)
    assert not res.allowed


@given(
    cash=st.decimals(min_value=0, max_value=10**6, places=2),
    qty=st.integers(min_value=1, max_value=2000),
    price=st.decimals(min_value="0.5", max_value=1000, places=2),
    side=st.sampled_from(["buy", "sell"]),
    held=st.integers(min_value=0, max_value=2000),
    trades=st.integers(min_value=0, max_value=12),
)
@PROP
def test_validate_is_consistent_with_its_checks(
    cash: Decimal, qty: int, price: Decimal, side: str, held: int, trades: int
) -> None:
    """allowed <=> no violations <=> no 'blocked' check; sells can only violate shares/trades; never raises."""
    positions = (Position("AAA", "Tech", D(held), D("100")),) if held else ()
    pf = Portfolio(cash, positions, trades)
    res = validate(TradeProposal("AAA", side, D(qty), price), pf, RULES)  # type: ignore[arg-type]
    assert res.allowed == (not res.violations)
    assert res.allowed == (not any(c.severity == "blocked" for c in res.checks))
    assert all(c.ok == (c.severity == "pass") for c in res.checks)
    if side == "sell":
        assert {v.rule for v in res.violations} <= {"shares"}
        assert res.allowed == (qty <= held)
    else:
        assert ("funds" in {v.rule for v in res.violations}) == (D(qty) * price > cash)


def test_validate_never_loosens_rules() -> None:
    """The engine is a pure function: calling it never mutates the (frozen) rules or portfolio."""
    rules = Rules(D(10), D(25), D(10), 3, D(10))
    pf = Portfolio(D(100), (Position("A", "T", D(1), D(100)),))
    before = (rules, pf)
    validate(TradeProposal("A", "buy", D(1), D(10)), pf, rules)
    assert (rules, pf) == before


# ---------------------------------------------------------------------------------------- sizing (design pq)


def test_suggest_reduction_matches_design_pq_for_priya() -> None:
    from scripts.seed_data import PRIYA, UNIVERSE_BY_SYMBOL

    positions = tuple(
        Position(s, UNIVERSE_BY_SYMBOL[s].sector, D(q), UNIVERSE_BY_SYMBOL[s].px)
        for s, q, _ in PRIYA.holdings
    )
    pf = Portfolio(PRIYA.cash, positions)
    rules = Rules.from_mapping(PRIYA.rules)
    assert suggest_reduction(pf, rules, rule="pos", symbol="JNJ") == 4
    assert suggest_reduction(pf, rules, rule="sec", symbol="PEP") == 11
    assert suggest_reduction(pf, rules, rule="pos", symbol="KO") == 0  # under the cap
    assert suggest_reduction(pf, rules, rule="pos", symbol="NOPE") == 0


def test_suggest_reduction_caps_at_shares_held() -> None:
    pf = Portfolio(D(0), (Position("A", "T", D(2), D(100)), Position("B", "U", D(1), D(1))))
    rules = Rules(D(1), D(1), D(10), 3, D(0))
    assert suggest_reduction(pf, rules, rule="pos", symbol="A") == 2
